# ============================================================
# Variables d'environnement pour docker-compose.yml
# Copiez ce fichier vers .env à la racine du projet :
#   cp .env.docker .env
# Puis remplissez JWT_SECRET et JWT_REFRESH_SECRET
# ============================================================

# JWT — OBLIGATOIRE (générez avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=<GÉNÉREZ_UN_SECRET_FORT>
JWT_REFRESH_SECRET=<GÉNÉREZ_UN_SECRET_FORT>
JWT_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (optionnel — laissez les valeurs par défaut si non utilisé)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_MONTHLY=price_placeholder_monthly
STRIPE_PRICE_ID_YEARLY=price_placeholder_yearly

# Firebase (optionnel)
FIREBASE_SERVICE_ACCOUNT=

# Cloudinary (optionnel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
