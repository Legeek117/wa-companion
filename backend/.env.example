# ====================================
# Database Configuration
# ====================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/amda"

# ====================================
# JWT Configuration
# ====================================
JWT_SECRET="your-jwt-secret-key-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="7d"

# ====================================
# Server Configuration
# ====================================
NODE_ENV="development"
PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ====================================
# WhatsApp Configuration
# ====================================
WHATSAPP_SESSION_PATH="./sessions"
WHATSAPP_SESSION_TIMEOUT=60000

# ====================================
# Media Storage (Local filesystem)
# ====================================
UPLOADS_PATH="./uploads"

# ====================================
# Redis Configuration (Optional)
# ====================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=""

# ====================================
# Stripe Configuration
# ====================================
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
STRIPE_PRICE_ID_MONTHLY="price_your_monthly_price_id"
STRIPE_PRICE_ID_YEARLY="price_your_yearly_price_id"

# ====================================
# Firebase Configuration (Push Notifications)
# ====================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"

# ====================================
# Logging Configuration
# ====================================
LOG_LEVEL="info"

# ====================================
# Cloudinary Configuration (Optional - for media hosting)
# ====================================
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"
