// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Plan {
  free
  premium

  @@map("plan")
}

enum SessionStatus {
  disconnected
  connecting
  connected

  @@map("session_status")
}

enum MediaType {
  text
  image
  video
  audio
  document
  sticker

  @@map("media_type")
}

enum ActionType {
  view_and_like
  view_only

  @@map("action_type")
}

enum AutoresponderMode {
  offline
  busy
  meeting
  vacation
  custom
  disabled

  @@map("autoresponder_mode")
}

enum ScheduledStatusStatus {
  pending
  published
  failed
  canceled

  @@map("scheduled_status_status")
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  trialing
  incomplete
  incomplete_expired

  @@map("subscription_status")
}

enum NotificationType {
  view_once
  status_liked
  deleted_message

  @@map("notification_type")
}

// Models
model User {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email     String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  plan      Plan     @default(free)
  subscriptionId String?  @map("subscription_id") @db.VarChar(255)
  logMessages Boolean  @default(false) @map("log_messages")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions         Subscription[]
  whatsappSessions      WhatsappSession[]
  contacts              Contact[]
  whatsappMessages      WhatsappMessage[]
  statusLikes           StatusLike[]
  statusAutoLikeConfig  StatusAutoLikeConfig[]
  statusConfig          StatusConfig?
  viewOnceCaptures      ViewOnceCapture[]
  deletedMessages       DeletedMessage[]
  autoresponderConfig   AutoresponderConfig[]
  autoresponderContacts AutoresponderContact[]
  viewOnceCommandConfig ViewOnceCommandConfig?
  scheduledStatuses     ScheduledStatus[]
  quota                 Quota?
  analytics             Analytics[]
  notifications         Notification[]
  notificationSettings  NotificationSettings?
  fcmTokens             FcmToken[]

  @@index([email])
  @@index([plan])
  @@map("users")
}

model Admin {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([email])
  @@map("admins")
}

model Subscription {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  stripeSubscriptionId String               @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripeCustomerId    String               @map("stripe_customer_id") @db.VarChar(255)
  plan                Plan
  status              SubscriptionStatus
  currentPeriodStart  DateTime             @map("current_period_start") @db.Timestamptz
  currentPeriodEnd    DateTime             @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd   Boolean              @default(false) @map("cancel_at_period_end")
  canceledAt          DateTime?            @map("canceled_at") @db.Timestamptz
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model WhatsappSession {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  sessionId   String        @unique @map("session_id") @db.VarChar(255)
  qrCode      String?       @map("qr_code") @db.Text
  pairingCode String?       @map("pairing_code") @db.VarChar(20)
  status      SessionStatus @default(disconnected)
  connectedAt DateTime?     @map("connected_at") @db.Timestamptz
  lastSeen    DateTime?     @map("last_seen") @db.Timestamptz
  sessionData Json?         @map("session_data") @db.JsonB
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@map("whatsapp_sessions")
}

model Contact {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contactId   String   @map("contact_id") @db.VarChar(255)
  contactName String   @map("contact_name") @db.VarChar(255)
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
  @@index([lastSeenAt])
  @@map("contacts")
}

model WhatsappMessage {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  contactId String    @map("contact_id") @db.VarChar(255)
  messageId String    @map("message_id") @db.VarChar(255)
  fromMe    Boolean   @default(false) @map("from_me")
  content   String?   @db.Text
  mediaUrl  String?   @map("media_url") @db.Text
  mediaType MediaType? @map("media_type")
  timestamp DateTime  @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([contactId])
  @@index([timestamp(sort: Desc)])
  @@map("whatsapp_messages")
}

model StatusLike {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  contactId String   @map("contact_id") @db.VarChar(255)
  contactName String  @map("contact_name") @db.VarChar(255)
  statusId  String   @map("status_id") @db.VarChar(255)
  emojiUsed String   @default("❤️") @map("emoji_used") @db.VarChar(10)
  likedAt   DateTime @default(now()) @map("liked_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contactId])
  @@index([likedAt])
  @@index([userId, contactId])
  @@map("status_likes")
}

model StatusAutoLikeConfig {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  contactId String      @map("contact_id") @db.VarChar(255)
  contactName String     @map("contact_name") @db.VarChar(255)
  enabled   Boolean     @default(true)
  emoji     String      @default("❤️") @db.VarChar(10)
  actionType ActionType? @map("action_type")
  watchOnly Boolean     @default(false) @map("watch_only")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
  @@index([enabled])
  @@map("status_auto_like_config")
}

model ViewOnceCapture {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  senderId  String    @map("sender_id") @db.VarChar(255)
  senderName String   @map("sender_name") @db.VarChar(255)
  mediaUrl  String    @map("media_url") @db.Text
  mediaType MediaType @map("media_type")
  fileSize  BigInt?   @map("file_size")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([senderId])
  @@index([capturedAt])
  @@index([userId, capturedAt(sort: Desc)])
  @@map("view_once_captures")
}

model DeletedMessage {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  senderId  String    @map("sender_id") @db.VarChar(255)
  senderName String   @map("sender_name") @db.VarChar(255)
  messageId String    @map("message_id") @db.VarChar(255)
  content   String?   @db.Text
  mediaUrl  String?   @map("media_url") @db.Text
  mediaType MediaType? @map("media_type")
  sentAt    DateTime  @map("sent_at") @db.Timestamptz
  deletedAt DateTime  @map("deleted_at") @db.Timestamptz
  delaySeconds Int?    @map("delay_seconds")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([senderId])
  @@index([deletedAt])
  @@index([userId, deletedAt(sort: Desc)])
  @@map("deleted_messages")
}

model AutoresponderConfig {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String               @map("user_id") @db.Uuid
  mode               AutoresponderMode
  message            String               @db.Text
  enabled            Boolean              @default(false)
  autoActivateOffline Boolean             @default(true) @map("auto_activate_offline")
  scheduleConfig     Json?                @map("schedule_config") @db.JsonB
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mode])
  @@index([userId])
  @@index([mode])
  @@index([enabled])
  @@map("autoresponder_config")
}

model AutoresponderContact {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contactId   String   @map("contact_id") @db.VarChar(255)
  contactName String   @map("contact_name") @db.VarChar(255)
  enabled     Boolean  @default(true)
  customMessage String? @map("custom_message") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
  @@index([enabled])
  @@map("autoresponder_contacts")
}

model ViewOnceCommandConfig {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  commandText String   @default(".vv") @map("command_text") @db.VarChar(50)
  commandEmoji String? @map("command_emoji") @db.VarChar(10)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("view_once_command_config")
}

model ScheduledStatus {
  id        String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  mediaUrl  String?               @map("media_url") @db.Text
  caption   String?               @db.Text
  scheduledAt DateTime            @map("scheduled_at") @db.Timestamptz
  publishedAt DateTime?           @map("published_at") @db.Timestamptz
  status    ScheduledStatusStatus @default(pending)
  errorMessage String?            @map("error_message") @db.Text
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
  @@index([userId, status])
  @@map("scheduled_statuses")
}

model Quota {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  viewOnceCount        Int      @default(0) @map("view_once_count")
  deletedMessagesCount Int      @default(0) @map("deleted_messages_count")
  scheduledStatusesCount Int    @default(0) @map("scheduled_statuses_count")
  resetDate            DateTime @map("reset_date") @db.Date
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resetDate])
  @@map("quotas")
}

model Analytics {
  id                       String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  date                     DateTime @db.Date
  statusLikesCount         Int      @default(0) @map("status_likes_count")
  viewOnceCapturesCount    Int      @default(0) @map("view_once_captures_count")
  deletedMessagesCount     Int      @default(0) @map("deleted_messages_count")
  autoresponderResponsesCount Int   @default(0) @map("autoresponder_responses_count")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([userId, date(sort: Desc)])
  @@map("analytics")
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.Text
  body      String           @db.Text
  imageUrl  String?          @map("image_url") @db.Text
  data      Json?            @db.JsonB
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt(sort: Desc)])
  @@index([type])
  @@map("notifications")
}

model NotificationSettings {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  enabled        Boolean  @default(true)
  viewOnce       Boolean  @default(true) @map("view_once")
  statusLiked    Boolean  @default(true) @map("status_liked")
  deletedMessage Boolean  @default(true) @map("deleted_message")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_settings")
}

model FcmToken {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.Text
  deviceInfo Json?   @map("device_info") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("fcm_tokens")
}


model StatusConfig {
  id String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  enabled Boolean @default(false)
  actionType ActionType? @default(view_and_like) @map("action_type")
  defaultEmoji String @default("❤️") @map("default_emoji") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("status_config")
}

model AdminSetting {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  settingKey  String   @unique @map("setting_key") @db.VarChar(100)
  value       Boolean  @default(true)
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("admin_settings")
}
